modules = ["php-8.2", "bash"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Laravel Server"

[[workflows.workflow]]
name = "Laravel Server"
author = 43308247
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "composer install --no-dev --optimize-autoloader"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan key:generate --force"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan migrate --force"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host=0.0.0.0 --port=5000"
